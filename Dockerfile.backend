FROM python:3.13-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

ARG PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

WORKDIR /app

COPY backend/requirements.txt /tmp/requirements.txt

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        build-essential \
        libarchive13 \
        libgomp1 \
        libmagic1 \
    && python -m pip install --upgrade pip \
    && python -m pip install --index-url "${PYTORCH_INDEX_URL}" "torch>=2.11,<3" \
    && python -m pip install -r /tmp/requirements.txt \
    && apt-get purge --yes --auto-remove build-essential \
    && rm -rf /var/lib/apt/lists/* /tmp/requirements.txt

ENV PYTHONPATH=/app

RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /app/runtime \
    && chown -R appuser:appuser /app

COPY --chown=appuser:appuser backend /app/backend
COPY --chown=appuser:appuser docker/bootstrap_database.py /app/docker/bootstrap_database.py

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=20 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=4)"]

CMD ["sh", "-c", "python /app/docker/bootstrap_database.py && exec uvicorn backend.server.main:app --host 0.0.0.0 --port 8000"]
