# Copy this file to .env.production at the repository root and replace every
# placeholder before starting the production Compose stack.
APP_DOMAIN=security.example.com
ACME_EMAIL=admin@example.com
LOCAL_APP_PORT=3000

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
JWT_SECRET_KEY=REPLACE_WITH_A_32_PLUS_CHARACTER_RANDOM_SECRET
WS_ALLOW_LEGACY_QUERY_AUTH=false

SQL_ENFORCEMENT_MODE=monitor
FILE_SCAN_QUEUE_BACKEND=memory
FILE_SCAN_QUEUE_PROCESSOR_ENABLED=true

# Deliberately disabled for the first public demo. Review model governance,
# backups, resource limits, and promotion criteria before changing these.
PROD_DEFENDER_SPAM_AUTO_RETRAIN_ENABLED=false
PROD_SPAM_AUTOPIPELINE_ENABLED=false
PROD_SPAM_AUTOPIPELINE_RUN_ON_START=false
